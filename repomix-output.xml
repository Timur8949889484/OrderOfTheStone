const BLOCK_SIZE = 1.5;

type Listener = (x: number, y: number, z: number) => void;

class BlockStore {
  private blocks = new Set<string>();
  private listeners = new Set<Listener>();

  // Кэш для бинарного массива (чтобы не создавать его заново для каждого из 900 чанков)
  private cachedBuffer: Int32Array | null = null;

  init(initialBlocks?: string[]) {
    this.blocks = new Set(initialBlocks || []);
    this.cachedBuffer = null; // Сбрасываем кэш при загрузке мира
  }

  breakBlock(x: number, y: number, z: number) {
    const gx = Math.round(x);
    const gy = Math.round(y);
    const gz = Math.round(z);

    const key = `${gx},${gy},${gz}`;

    if (!this.blocks.has(key)) {
      this.blocks.add(key);
      this.cachedBuffer = null; // Инвалидируем кэш, так как блоки изменились
      this.notify(gx, gy, gz);
    }
  }

  isBlockBroken(gx: number, gy: number, gz: number): boolean {
    return this.blocks.has(`${gx},${gy},${gz}`);
  }

  getBlocksArray(): string[] {
    return Array.from(this.blocks); // Нужно только для сохранения в БД
  }

  // НОВАЯ ФУНКЦИЯ: Превращает Set строк в супер-быстрый массив чисел [x1,y1,z1, x2,y2,z2...]
  getBlocksBuffer(): Int32Array {
    if (this.cachedBuffer) return this.cachedBuffer;

    const arr = new Int32Array(this.blocks.size * 3);
    let i = 0;
    for (const key of this.blocks) {
      const comma1 = key.indexOf(",");
      const comma2 = key.indexOf(",", comma1 + 1);
      arr[i++] = parseInt(key.substring(0, comma1), 10);
      arr[i++] = parseInt(key.substring(comma1 + 1, comma2), 10);
      arr[i++] = parseInt(key.substring(comma2 + 1), 10);
    }

    this.cachedBuffer = arr;
    return arr;
  }

  subscribe(listener: Listener) {
    this.listeners.add(listener);
    return () => this.listeners.delete(listener);
  }

  private notify(x: number, y: number, z: number) {
    this.listeners.forEach((l) => l(x, y, z));
  }
}

export const blockStore = new BlockStore();
</file>

<file path="src/store/chunkStore.ts">
import { blockStore } from "./blockStore";

// Храним бинарные карты блоков для каждого чанка
export const chunkDataStore = new Map<string, Uint8Array>();

const CHUNK_SIZE = 10;
const LIGHT_PAD = 12;
const W = CHUNK_SIZE + LIGHT_PAD * 2;
const D = CHUNK_SIZE + LIGHT_PAD * 2;
const MIN_Y = -31;
const MAX_Y = 128;

// КЭШ: Сохраняем последний запрошенный чанк. Физика проверяет сотни блоков
// внутри одного чанка, поэтому это ускорит поиск в 100+ раз!
let lastChunkKey = "";
let lastChunkX = -999999;
let lastChunkZ = -999999;

export function getGlobalBlock(
  worldX: number,
  worldY: number,
  worldZ: number,
): number {
  const wx = Math.round(worldX);
  const wy = Math.round(worldY);
  const wz = Math.round(worldZ);

  if (blockStore.isBlockBroken(wx, wy, wz)) return 0;

  const chunkX = Math.floor(wx / CHUNK_SIZE);
  const chunkZ = Math.floor(wz / CHUNK_SIZE);

  let chunkMap;
  if (chunkX === lastChunkX && chunkZ === lastChunkZ) {
    chunkMap = chunkDataStore.get(lastChunkKey);
  } else {
    lastChunkKey = `${chunkX},${chunkZ}`;
    lastChunkX = chunkX;
    lastChunkZ = chunkZ;
    chunkMap = chunkDataStore.get(lastChunkKey);
  }

  // Если чанка нет, возвращаем -1 (невидимая стена), а не 0 (воздух)
  if (!chunkMap) return -1;

  const lx = wx - chunkX * CHUNK_SIZE;
  const lz = wz - chunkZ * CHUNK_SIZE;

  if (wy < MIN_Y || wy > MAX_Y) return 0;

  const idx = lx + LIGHT_PAD + (lz + LIGHT_PAD) * W + (wy - MIN_Y) * W * D;
  return chunkMap[idx] || 0;
}
</file>

<file path="src/utils/chunkWorkerManager.ts">
// src/utils/chunkWorkerManager.ts

// Определяем количество доступных ядер процессора (оставляем 1 ядро для самой игры)
const hardwareThreads = navigator.hardwareConcurrency || 4;
const NUM_WORKERS = Math.max(1, hardwareThreads - 1);

// Создаем ПУЛ воркеров
const workers: Worker[] = [];
for (let i = 0; i < NUM_WORKERS; i++) {
  workers.push(
    new Worker(
      new URL("../components/Chunk/chunk.worker.ts", import.meta.url),
      {
        type: "module",
      },
    ),
  );
}

let nextWorkerIndex = 0;
type ChunkCallback = (data: any) => void;
const listeners = new Map<string, ChunkCallback>();

// Назначаем обработчик ответов всем воркерам
const handleMessage = (e: MessageEvent) => {
  if (!e.data || typeof e.data !== "object" || e.data.type === "vite-hmr")
    return;
  const key = `${e.data.chunkX},${e.data.chunkZ}`;
  const callback = listeners.get(key);
  if (callback) {
    callback(e.data);
  }
};

workers.forEach((worker) => {
  worker.onmessage = handleMessage;
});

export const requestChunkData = (
  chunkX: number,
  chunkZ: number,
  chunkSize: number,
  seed: string | undefined,
  modifiedBlocksBuffer: Int32Array,
  onData: ChunkCallback,
) => {
  const key = `${chunkX},${chunkZ}`;
  listeners.set(key, onData);

  // Берем следующего свободного воркера по кругу (Round-Robin)
  const worker = workers[nextWorkerIndex];
  nextWorkerIndex = (nextWorkerIndex + 1) % NUM_WORKERS;

  worker.postMessage({
    chunkX,
    chunkZ,
    chunkSize,
    seed,
    modifiedBlocksBuffer,
  });
};

export const removeChunkListener = (chunkX: number, chunkZ: number) => {
  const key = `${chunkX},${chunkZ}`;
  listeners.delete(key);
};

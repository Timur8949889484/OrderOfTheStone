import { useState, useCallback, useEffect } from "react";
import { BlockParticles } from "../Particles/BlockParticles";
import { getBlockTexture } from "../../utils/materials";

const BLOCK_SIZE = 1.5;

export const ParticleManager = () => {
  const [particleBursts, setParticleBursts] = useState<any[]>([]);

  const removeParticles = useCallback((id: number) => {
    setParticleBursts((prev) => prev.filter((p) => p.id !== id));
  }, []);

  useEffect(() => {
    const handleMining = (e: any) => {
      const { x, y, z, blockType } = e.detail;
      setParticleBursts((prev) => {
        if (prev.length > 15) return prev;
        return [
          ...prev,
          {
            id: performance.now() + Math.random(),
            position: [x * BLOCK_SIZE, (y - 0.5) * BLOCK_SIZE, z * BLOCK_SIZE],
            texture: getBlockTexture(blockType),
            count: 3,
            speedMultiplier: 0.6,
          },
        ];
      });
    };

    const handleBreak = (e: any) => {
      const { x, y, z, blockType } = e.detail;
      setParticleBursts((prev) => [
        ...prev.slice(-10),
        {
          id: performance.now() + Math.random(),
          position: [x * BLOCK_SIZE, (y - 0.5) * BLOCK_SIZE, z * BLOCK_SIZE],
          texture: getBlockTexture(blockType),
          count: 20,
          speedMultiplier: 1.5,
        },
      ]);
    };

    window.addEventListener("spawn-mining-particles", handleMining);
    window.addEventListener("spawn-break-particles", handleBreak);

    return () => {
      window.removeEventListener("spawn-mining-particles", handleMining);
      window.removeEventListener("spawn-break-particles", handleBreak);
    };
  }, []);

  return (
    <>
      {particleBursts.map((burst) => (
        <BlockParticles
          key={burst.id}
          id={burst.id}
          position={burst.position}
          texture={burst.texture}
          count={burst.count}
          speedMultiplier={burst.speedMultiplier}
          onComplete={removeParticles}
        />
      ))}
    </>
  );
};
</file>

<file path="src/components/Particles/BlockParticles.tsx">
import { useRef, useMemo, useEffect } from "react";
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";
import { getBlockType } from "../../utils/terrain";
import { blockStore } from "../../store/blockStore";

const dummy = new THREE.Object3D();
const BLOCK_SIZE = 1.5;

interface BlockParticlesProps {
  id: number;
  position: [number, number, number];
  texture: THREE.Texture;
  count?: number;
  speedMultiplier?: number;
  onComplete: (id: number) => void;
}

// ВОТ ЗДЕСЬ ОБЯЗАТЕЛЬНО ДОЛЖНО БЫТЬ СЛОВО export
export const BlockParticles = ({
  id,
  position,
  texture,
  count = 12,
  speedMultiplier = 1,
  onComplete,
}: BlockParticlesProps) => {
  const meshRef = useRef<THREE.InstancedMesh>(null);

  // Data-Oriented Design: Вместо объектов используем плоские массивы чисел! 0 мусора в памяти.
  const { pos, vel, scale, shrink, delay } = useMemo(() => {
    const pos = new Float32Array(count * 3);
    const vel = new Float32Array(count * 3);
    const scale = new Float32Array(count);
    const shrink = new Float32Array(count);
    const delay = new Float32Array(count);

    const spread = 0.6;
    for (let i = 0; i < count; i++) {
      pos[i * 3] = position[0] + (Math.random() - 0.5) * spread;
      pos[i * 3 + 1] = position[1] + (Math.random() - 0.5) * spread;
      pos[i * 3 + 2] = position[2] + (Math.random() - 0.5) * spread;

      vel[i * 3] = (Math.random() - 0.5) * 3 * speedMultiplier;
      vel[i * 3 + 1] = Math.random() * 2.5 * speedMultiplier + 0.5;
      vel[i * 3 + 2] = (Math.random() - 0.5) * 3 * speedMultiplier;

      scale[i] = Math.random() * 0.2 + 0.1;
      shrink[i] = Math.random() * 0.8 + 0.5;
      delay[i] = Math.random() * 0.1 + 0.1;
    }
    return { pos, vel, scale, shrink, delay };
  }, [position, count, speedMultiplier]);

  const ageRef = useRef(0);

  useEffect(() => {
    const timer = setTimeout(() => onComplete(id), 600);
    return () => clearTimeout(timer);
  }, [id, onComplete]);

  useFrame(({ camera }, delta) => {
    if (!meshRef.current) return;
    const safeDelta = Math.min(delta, 0.05);
    ageRef.current += safeDelta;
    const currentAge = ageRef.current;

    for (let i = 0; i < count; i++) {
      let px = pos[i * 3];
      let py = pos[i * 3 + 1];
      let pz = pos[i * 3 + 2];

      let vx = vel[i * 3];
      let vy = vel[i * 3 + 1];
      let vz = vel[i * 3 + 2];

      // Если частица еще в движении
      if (vy !== 0 || vx !== 0 || vz !== 0) {
        vy -= 18 * safeDelta;

        const nextX = px + vx * safeDelta;
        const nextY = py + vy * safeDelta;
        const nextZ = pz + vz * safeDelta;

        const gridX = Math.round(nextX / BLOCK_SIZE);
        const gridY = Math.round(nextY / BLOCK_SIZE + 0.5);
        const gridZ = Math.round(nextZ / BLOCK_SIZE);

        const isBroken = blockStore.isBlockBroken(gridX, gridY, gridZ);
        const blockBelow = isBroken ? 0 : getBlockType(gridX, gridY, gridZ);

        if (blockBelow !== 0) {
          const blockTopY = gridY * BLOCK_SIZE;
          if (py >= blockTopY && nextY <= blockTopY) {
            py = blockTopY + 0.02;
            vx = 0;
            vy = 0;
            vz = 0; // Упали на землю - останавливаемся
          } else {
            py = nextY;
          }
        } else {
          py = nextY;
        }

        if (vy !== 0) {
          px = nextX;
          pz = nextZ;
        }

        pos[i * 3] = px;
        pos[i * 3 + 1] = py;
        pos[i * 3 + 2] = pz;
        vel[i * 3] = vx;
        vel[i * 3 + 1] = vy;
        vel[i * 3 + 2] = vz;
      }

      if (currentAge > delay[i]) {
        scale[i] -= shrink[i] * safeDelta;
      }
      const currentScale = Math.max(0, scale[i]);

      dummy.position.set(px, py, pz);
      dummy.quaternion.copy(camera.quaternion); // Частицы смотрят в камеру
      dummy.scale.set(currentScale, currentScale, currentScale);
      dummy.updateMatrix();

      meshRef.current!.setMatrixAt(i, dummy.matrix);
    }

    meshRef.current.instanceMatrix.needsUpdate = true;
  });

  return (
    <instancedMesh
      ref={meshRef}
      args={[undefined as any, undefined as any, count]}
      frustumCulled={false}
    >
      <planeGeometry args={[1, 1]} />
      <meshStandardMaterial
        map={texture}
        side={THREE.DoubleSide}
        transparent
        alphaTest={0.1}
        roughness={0.9}
        metalness={0.1}
      />
    </instancedMesh>
  );
};
</file>

<file path="src/components/Player/hooks/useMobileCamera.ts">
import { useEffect, useRef } from "react";
import * as THREE from "three";
import { mobileControls } from "../../../utils/mobileControls";

const euler = new THREE.Euler(0, 0, 0, "YXZ");
const PI_2 = Math.PI / 2;

export function useMobileCamera(camera: THREE.Camera, isPaused: boolean) {
  const touchId = useRef<number | null>(null);
  const startTouch = useRef<{ x: number; y: number } | null>(null);
  const lastTouch = useRef<{ x: number; y: number } | null>(null);

  // Флаг: мы сейчас ломаем блок или крутим головой?
  const isSwiping = useRef(false);

  useEffect(() => {
    if (isPaused) {
      touchId.current = null;
      startTouch.current = null;
      lastTouch.current = null;
      mobileControls.isMining = false;
      return;
    }

    const handleTouchStart = (e: TouchEvent) => {
      const target = e.target as HTMLElement;
      if (
        target.closest(".joystick-zone") ||
        target.closest(".jump-btn") ||
        target.closest(".pause-btn-mobile")
      ) {
        return;
      }

      if (touchId.current !== null) return;

      for (let i = 0; i < e.changedTouches.length; i++) {
        const touch = e.changedTouches[i];
        if (touch.clientX > window.innerWidth / 2) {
          touchId.current = touch.identifier;

          // Запоминаем, где палец коснулся экрана
          startTouch.current = { x: touch.clientX, y: touch.clientY };
          lastTouch.current = { x: touch.clientX, y: touch.clientY };
          isSwiping.current = false;

          // Начинаем ломать блок
          mobileControls.isMining = true;
          mobileControls.mineCoords = { x: touch.clientX, y: touch.clientY };
          break;
        }
      }
    };

    const handleTouchMove = (e: TouchEvent) => {
      if (touchId.current === null || !startTouch.current || !lastTouch.current)
        return;

      for (let i = 0; i < e.changedTouches.length; i++) {
        const touch = e.changedTouches[i];
        if (touch.identifier === touchId.current) {
          // Вычисляем, как далеко ушел палец от первоначальной точки
          const dxStart = touch.clientX - startTouch.current.x;
          const dyStart = touch.clientY - startTouch.current.y;
          const distance = Math.sqrt(dxStart * dxStart + dyStart * dyStart);

          // Если палец ушел больше чем на 10 пикселей - это свайп!
          if (!isSwiping.current && distance > 10) {
            isSwiping.current = true;

            // Прекращаем ломать блок, так как крутим головой
            mobileControls.isMining = false;
            mobileControls.mineReleaseTime = performance.now();
          }

          if (isSwiping.current) {
            // КРУТИМ КАМЕРУ
            const movementX = touch.clientX - lastTouch.current.x;
            const movementY = touch.clientY - lastTouch.current.y;

            const sensitivity = 0.005;
            euler.setFromQuaternion(camera.quaternion);
            euler.y -= movementX * sensitivity;
            euler.x -= movementY * sensitivity;
            euler.x = Math.max(-PI_2, Math.min(PI_2, euler.x));
            camera.quaternion.setFromEuler(euler);

            lastTouch.current = { x: touch.clientX, y: touch.clientY };
          } else {
            // ЕСЛИ НЕ СВАЙПАЕМ - просто обновляем микро-координаты для кирки
            mobileControls.mineCoords = { x: touch.clientX, y: touch.clientY };
          }
        }
      }
    };

    const handleTouchEnd = (e: TouchEvent) => {
      if (touchId.current === null) return;
      for (let i = 0; i < e.changedTouches.length; i++) {
        if (e.changedTouches[i].identifier === touchId.current) {
          touchId.current = null;

          // Отпустили палец - отменяем ломание
          if (!isSwiping.current) {
            mobileControls.isMining = false;
            mobileControls.mineReleaseTime = performance.now();
          }
        }
      }
    };

    document.addEventListener("touchstart", handleTouchStart, {
      passive: false,
    });
    document.addEventListener("touchmove", handleTouchMove, { passive: false });
    document.addEventListener("touchend", handleTouchEnd, { passive: false });
    document.addEventListener("touchcancel", handleTouchEnd, {
      passive: false,
    });

    return () => {
      document.removeEventListener("touchstart", handleTouchStart);
      document.removeEventListener("touchmove", handleTouchMove);
      document.removeEventListener("touchend", handleTouchEnd);
      document.removeEventListener("touchcancel", handleTouchEnd);
    };
  }, [camera, isPaused]);
}
</file>

<file path="src/components/Player/hooks/usePlayerControls.ts">
import { useEffect, useRef } from "react";
import type { PointerLockControls } from "@react-three/drei";

interface UsePlayerControlsProps {
  isPaused: boolean;
  controlsRef: React.RefObject<React.ComponentRef<
    typeof PointerLockControls
  > | null>;
  setShowFPS: React.Dispatch<React.SetStateAction<boolean>>;
}

export function usePlayerControls({
  isPaused,
  controlsRef,
  setShowFPS,
}: UsePlayerControlsProps) {
  // Храним состояния в refs, чтобы не вызывать ререндер при каждом нажатии
  const keysPressed = useRef<{ [key: string]: boolean }>({});
  const isMining = useRef(false);
  const mineReleaseTime = useRef(0);
  const zoomDistance = useRef(0);

  // Сбрасываем зажатые клавиши, если игра ставится на паузу
  useEffect(() => {
    if (isPaused) {
      keysPressed.current = {};
    }
  }, [isPaused]);

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.code === "Space") {
        e.preventDefault(); // Предотвращаем прокрутку страницы пробелом
      }

      if (e.code === "NumpadDivide" || e.key === "/") {
        setShowFPS((prev) => !prev);
      }

      // Освобождаем курсор (выход в меню) при нажатии P или E
      if ((e.code === "KeyP" || e.code === "KeyE") && !isPaused) {
        if (controlsRef.current) {
          controlsRef.current.unlock();
        }
      }

      keysPressed.current[e.code] = true;
    };

    const handleKeyUp = (e: KeyboardEvent) => {
      keysPressed.current[e.code] = false;
    };

    // Очищаем клавиши, если окно потеряло фокус (Alt+Tab)
    const handleBlur = () => {
      keysPressed.current = {};
    };

    // Приближение/отдаление камеры (zoom)
    const handleWheel = (e: WheelEvent) => {
      if (document.pointerLockElement) {
        const zoomSpeed = 0.01;
        let newZoom = zoomDistance.current + e.deltaY * zoomSpeed;

        if (newZoom < 0) newZoom = 0;
        if (newZoom > 10) newZoom = 10; // Ограничиваем максимальное отдаление

        zoomDistance.current = newZoom;
      }
    };

    // Левая кнопка мыши — начало добычи
    const handleMouseDown = (e: MouseEvent) => {
      if (document.pointerLockElement && e.button === 0) {
        isMining.current = true;
        mineReleaseTime.current = 0;
      }
    };

    // Отпускание кнопки мыши — прекращение добычи
    const handleMouseUp = (e: MouseEvent) => {
      if (e.button === 0) {
        isMining.current = false;
        mineReleaseTime.current = performance.now();
      }
    };

    // Подписываемся на события
    window.addEventListener("keydown", handleKeyDown);
    window.addEventListener("keyup", handleKeyUp);
    window.addEventListener("blur", handleBlur);
    window.addEventListener("wheel", handleWheel, { passive: true });
    window.addEventListener("mousedown", handleMouseDown);
    window.addEventListener("mouseup", handleMouseUp);

    // Отписываемся при размонтировании
    return () => {
      window.removeEventListener("keydown", handleKeyDown);
      window.removeEventListener("keyup", handleKeyUp);
      window.removeEventListener("blur", handleBlur);
      window.removeEventListener("wheel", handleWheel);
      window.removeEventListener("mousedown", handleMouseDown);
      window.removeEventListener("mouseup", handleMouseUp);
    };
  }, [setShowFPS, isPaused, controlsRef]);

  // Возвращаем refs, чтобы другие хуки (физика, майнинг) могли их читать
  return {
    keysPressed,
    isMining,
    mineReleaseTime,
    zoomDistance,
  };
}
</file>

<file path="src/components/Player/hooks/usePlayerMining.ts">
import { useRef } from "react";
import type { RefObject } from "react";
import * as THREE from "three";
import { crackMaterials } from "../../../utils/materials";
import { getGlobalBlock } from "../../../store/chunkStore";

import { blockStore } from "../../../store/blockStore";
import { IS_MOBILE } from "../../../utils/constants";
import { mobileControls } from "../../../utils/mobileControls";

const BLOCK_SIZE = 1.5;
const MAX_MINING_DISTANCE = 7.5;
const tempVisualTarget = new THREE.Vector3();

interface UsePlayerMiningProps {
  camera: THREE.Camera;
  isMining: React.MutableRefObject<boolean>;
  mineReleaseTime: React.MutableRefObject<number>;
  onBlockBreak?: (x: number, y: number, z: number, blockType?: number) => void;
  onMiningHit?: (x: number, y: number, z: number, blockType?: number) => void;
}

export function usePlayerMining({
  camera,
  isMining,
  mineReleaseTime,
  onBlockBreak,
  onMiningHit,
}: UsePlayerMiningProps) {
  const mineProgress = useRef(0);
  const mineTarget = useRef<THREE.Vector3 | null>(null);
  const particleTimer = useRef(0);
  const recentlyBrokenRef = useRef<Set<string>>(new Set());

  // Воксельный Raycast 3D DDA (в 1000 раз быстрее ThreeJS Raycaster)
  const getVoxelHit = (
    rayOrigin: THREE.Vector3,
    rayDir: THREE.Vector3,
    maxDist: number,
  ) => {
    let x = Math.floor(rayOrigin.x / BLOCK_SIZE + 0.5);
    let y = Math.floor(rayOrigin.y / BLOCK_SIZE + 1.0);
    let z = Math.floor(rayOrigin.z / BLOCK_SIZE + 0.5);

    const stepX = Math.sign(rayDir.x);
    const stepY = Math.sign(rayDir.y);
    const stepZ = Math.sign(rayDir.z);

    const voxelEdgeX =
      stepX > 0 ? (x + 0.5) * BLOCK_SIZE : (x - 0.5) * BLOCK_SIZE;
    const voxelEdgeY = stepY > 0 ? y * BLOCK_SIZE : (y - 1) * BLOCK_SIZE;
    const voxelEdgeZ =
      stepZ > 0 ? (z + 0.5) * BLOCK_SIZE : (z - 0.5) * BLOCK_SIZE;

    let tMaxX = stepX !== 0 ? (voxelEdgeX - rayOrigin.x) / rayDir.x : Infinity;
    let tMaxY = stepY !== 0 ? (voxelEdgeY - rayOrigin.y) / rayDir.y : Infinity;
    let tMaxZ = stepZ !== 0 ? (voxelEdgeZ - rayOrigin.z) / rayDir.z : Infinity;

    const tDeltaX = stepX !== 0 ? BLOCK_SIZE / Math.abs(rayDir.x) : Infinity;
    const tDeltaY = stepY !== 0 ? BLOCK_SIZE / Math.abs(rayDir.y) : Infinity;
    const tDeltaZ = stepZ !== 0 ? BLOCK_SIZE / Math.abs(rayDir.z) : Infinity;

    let hitDistance = 0;
    let normal = new THREE.Vector3();

    for (let i = 0; i < 20; i++) {
      if (hitDistance > maxDist) break;

      // const bType = getBlockType(x, y, z);
      const bType = getGlobalBlock(x, y, z);
      const isBroken = blockStore.isBlockBroken(x, y, z);
      const isRecentlyBroken = recentlyBrokenRef.current.has(`${x},${y},${z}`);

      if (bType !== 0 && !isBroken && !isRecentlyBroken) {
        return { x, y, z, normal, distance: hitDistance, blockType: bType };
      }

      if (tMaxX < tMaxY && tMaxX < tMaxZ) {
        hitDistance = tMaxX;
        x += stepX;
        tMaxX += tDeltaX;
        normal.set(-stepX, 0, 0);
      } else if (tMaxY < tMaxZ) {
        hitDistance = tMaxY;
        y += stepY;
        tMaxY += tDeltaY;
        normal.set(0, -stepY, 0);
      } else {
        hitDistance = tMaxZ;
        z += stepZ;
        tMaxZ += tDeltaZ;
        normal.set(0, 0, -stepZ);
      }
    }
    return null;
  };

  const updateMining = (
    dt: number,
    now: number,
    crackMeshRef: RefObject<THREE.Mesh>,
  ) => {
    const rayDir = new THREE.Vector3();

    // === ИСПРАВЛЕНИЕ: ОТКУДА СТРЕЛЯТЬ ЛУЧОМ? ===
    if (IS_MOBILE && mobileControls.mineCoords) {
      // Переводим 2D координаты пальца в 3D направление
      const mouse = new THREE.Vector2(
        (mobileControls.mineCoords.x / window.innerWidth) * 2 - 1,
        -(mobileControls.mineCoords.y / window.innerHeight) * 2 + 1,
      );
      const raycaster = new THREE.Raycaster();
      raycaster.setFromCamera(mouse, camera);
      rayDir.copy(raycaster.ray.direction);
    } else {
      // На ПК стреляем из центра экрана
      camera.getWorldDirection(rayDir);
    }
    rayDir.normalize();

    // === ИСПРАВЛЕНИЕ: ЧЬЁ СОСТОЯНИЕ ЧИТАТЬ? ===
    const isMiningNow = IS_MOBILE ? mobileControls.isMining : isMining.current;
    const releaseTimeNow = IS_MOBILE
      ? mobileControls.mineReleaseTime
      : mineReleaseTime.current;

    const hit = getVoxelHit(camera.position, rayDir, MAX_MINING_DISTANCE);

    if (hit) {
      tempVisualTarget.set(
        hit.x * BLOCK_SIZE,
        (hit.y - 0.5) * BLOCK_SIZE,
        hit.z * BLOCK_SIZE,
      );

      if (isMiningNow) {
        if (
          !mineTarget.current ||
          !mineTarget.current.equals(tempVisualTarget)
        ) {
          mineTarget.current = tempVisualTarget.clone();
          mineProgress.current = 0;
          particleTimer.current = 0;
        }

        mineProgress.current += dt;
        particleTimer.current += dt;

        if (particleTimer.current >= 0.15) {
          if (onMiningHit) {
            onMiningHit(hit.x, hit.y, hit.z, hit.blockType);
          }
          particleTimer.current = 0;
        }

        if (mineProgress.current >= 1) {
          const key = `${hit.x},${hit.y},${hit.z}`;
          recentlyBrokenRef.current.add(key);
          setTimeout(() => recentlyBrokenRef.current.delete(key), 600);

          if (onBlockBreak) onBlockBreak(hit.x, hit.y, hit.z, hit.blockType);

          mineProgress.current = 0;
          particleTimer.current = 0;
          mineTarget.current = null;
        }
      }
    } else {
      if (isMiningNow) {
        mineTarget.current = null;
        mineProgress.current = 0;
        particleTimer.current = 0;
      }
    }

    // ИСПРАВЛЕНИЕ: Заменяем mineReleaseTime.current на releaseTimeNow
    if (!isMiningNow && mineProgress.current > 0) {
      if (now - releaseTimeNow > 500) {
        mineProgress.current = 0;
        mineTarget.current = null;
      }
    }

    if (crackMeshRef.current) {
      if (mineProgress.current > 0 && mineTarget.current) {
        crackMeshRef.current.visible = true;
        crackMeshRef.current.position.copy(mineTarget.current);
        const stage = Math.min(9, Math.floor(mineProgress.current * 10));
        crackMeshRef.current.material = crackMaterials[stage];
      } else {
        crackMeshRef.current.visible = false;
      }
    }
  };

  return { updateMining };
}
</file>

<file path="src/components/Player/hooks/usePlayerPhysics.ts">
import { useRef, useEffect } from "react";
import * as THREE from "three";
import { initTerrainSeed } from "../../../utils/terrain";
import { getGlobalBlock } from "../../../store/chunkStore";

import { IS_MOBILE } from "../../../utils/constants";
import { mobileControls } from "../../../utils/mobileControls";

const BLOCK_SIZE = 1.5;
const PLAYER_HEIGHT_BLOCKS = 1.8;

const getBlockY = (yCoord: number) => Math.floor(yCoord / BLOCK_SIZE) + 1;

const frontVector = new THREE.Vector3();
const direction = new THREE.Vector3();
const upVector = new THREE.Vector3(0, 1, 0);
const rightVector = new THREE.Vector3();

const GRID_SLOTS = 9;
const gridXs = new Int32Array(GRID_SLOTS);
const gridZs = new Int32Array(GRID_SLOTS);
let gridCount = 0;

interface UsePlayerPhysicsProps {
  posRef: React.MutableRefObject<{ x: number; y: number; z: number }>;
  keysPressed: React.MutableRefObject<{ [key: string]: boolean }>;
  isPaused: boolean;
  mapSize: number;
  chunkSize: number;
  onChunkChange: (chunkX: number, chunkZ: number) => void;
  camera: THREE.Camera;
  worldId?: string | null;
  seed?: string;
}

export function usePlayerPhysics({
  posRef,
  keysPressed,
  isPaused,
  mapSize,
  chunkSize,
  onChunkChange,
  camera,
  worldId,
  seed = "default_seed",
}: UsePlayerPhysicsProps) {
  const velocityY = useRef(0);
  const lastChunk = useRef({
    x: Math.floor(posRef.current.x / (chunkSize * BLOCK_SIZE)),
    z: Math.floor(posRef.current.z / (chunkSize * BLOCK_SIZE)),
  });

  useEffect(() => {
    if (seed) {
      initTerrainSeed(seed);
    }
  }, [seed]);

  useEffect(() => {
    if (worldId) {
      velocityY.current = 0;
      const startChunkX = Math.floor(
        posRef.current.x / (chunkSize * BLOCK_SIZE),
      );
      const startChunkZ = Math.floor(
        posRef.current.z / (chunkSize * BLOCK_SIZE),
      );
      lastChunk.current = { x: startChunkX, z: startChunkZ };
    }
  }, [worldId, chunkSize, posRef]);

  const isSolidBlockOptimized = (
    worldX: number,
    blockYIndex: number,
    worldZ: number,
  ) => {
    const bType = getGlobalBlock(worldX, blockYIndex, worldZ);
    // ИСПРАВЛЕНИЕ: -1 это непрогруженный чанк. Считаем его твердым как камень!
    if (bType === -1) return true;

    return bType !== 0;
  };

  const fillPlayerGrids = (posX: number, posZ: number) => {
    gridCount = 0;
    // ИСПРАВЛЕНИЕ: Радиус коллайдера игрока уменьшен до 0.28 (игрок достаточно узкий).
    // Это снижает вероятность проверки сетки 3x3 и чаще оставляет 2x2 (4 блока вместо 9)
    const r = 0.28;
    const minX = Math.round((posX - r) / BLOCK_SIZE);
    const maxX = Math.round((posX + r) / BLOCK_SIZE);
    const minZ = Math.round((posZ - r) / BLOCK_SIZE);
    const maxZ = Math.round((posZ + r) / BLOCK_SIZE);

    for (let x = minX; x <= maxX; x++) {
      for (let z = minZ; z <= maxZ; z++) {
        if (gridCount < GRID_SLOTS) {
          gridXs[gridCount] = x;
          gridZs[gridCount] = z;
          gridCount++;
        }
      }
    }
  };

  const getGroundYAt = (posX: number, posZ: number, playerY: number) => {
    fillPlayerGrids(posX, posZ);
    const startBlockY = getBlockY(playerY + 0.5);
    let maxGround = -10 * BLOCK_SIZE;

    for (let i = 0; i < gridCount; i++) {
      const gx = gridXs[i];
      const gz = gridZs[i];

      // Просто сканируем вниз от позиции игрока. Ищем первый твердый блок.
      for (let y = startBlockY; y >= -10; y--) {
        if (isSolidBlockOptimized(gx, y, gz)) {
          const groundY = y * BLOCK_SIZE;
          if (groundY > maxGround) maxGround = groundY;
          break;
        }
      }
    }
    return maxGround;
  };

  const canFitAt = (posX: number, posY: number, posZ: number) => {
    fillPlayerGrids(posX, posZ);
    const feetYBlock = getBlockY(posY + 0.05);
    const headYBlock = getBlockY(
      posY + PLAYER_HEIGHT_BLOCKS * BLOCK_SIZE - 0.1,
    );

    for (let bY = feetYBlock; bY <= headYBlock; bY++) {
      for (let i = 0; i < gridCount; i++) {
        const gx = gridXs[i];
        const gz = gridZs[i];
        // Вызываем функцию строго с 3 аргументами!
        if (isSolidBlockOptimized(gx, bY, gz)) {
          return false;
        }
      }
    }
    return true;
  };

  const updatePhysics = (dt: number) => {
    if (isPaused) return;

    const keys = keysPressed.current;
    const speed = 11 * dt;

    camera.getWorldDirection(frontVector);
    frontVector.y = 0;
    frontVector.normalize();

    rightVector.crossVectors(frontVector, upVector).normalize();

    const groundBeforeMove = getGroundYAt(
      posRef.current.x,
      posRef.current.z,
      posRef.current.y,
    );
    const isGrounded =
      posRef.current.y <= groundBeforeMove + 0.1 && velocityY.current <= 0;

    let forward = 0;
    let right = 0;

    // ИСПРАВЛЕНИЕ: Читаем либо джойстик (на мобилках), либо клавиатуру (на ПК)
    if (IS_MOBILE) {
      forward = mobileControls.forward;
      right = mobileControls.right;
    } else {
      if (keys["KeyW"]) forward += 1;
      if (keys["KeyS"]) forward -= 1;
      if (keys["KeyA"]) right -= 1;
      if (keys["KeyD"]) right += 1;
    }

    if (keys["KeyW"]) forward += 1;
    if (keys["KeyS"]) forward -= 1;
    if (keys["KeyA"]) right -= 1;
    if (keys["KeyD"]) right += 1;

    if (forward !== 0 || right !== 0) {
      direction.set(0, 0, 0);
      if (forward !== 0) direction.addScaledVector(frontVector, forward);
      if (right !== 0) direction.addScaledVector(rightVector, right);

      direction.normalize().multiplyScalar(speed);
      const maxStepHeight = 0.5;

      const nextX = posRef.current.x + direction.x;
      if (canFitAt(nextX, posRef.current.y, posRef.current.z)) {
        posRef.current.x = nextX;
      } else if (
        isGrounded &&
        canFitAt(nextX, posRef.current.y + maxStepHeight, posRef.current.z)
      ) {
        posRef.current.x = nextX;
        posRef.current.y += maxStepHeight;
      }

      const nextZ = posRef.current.z + direction.z;
      if (canFitAt(posRef.current.x, posRef.current.y, nextZ)) {
        posRef.current.z = nextZ;
      } else if (
        isGrounded &&
        canFitAt(posRef.current.x, posRef.current.y + maxStepHeight, nextZ)
      ) {
        posRef.current.z = nextZ;
        posRef.current.y += maxStepHeight;
      }
    }

    const worldBoundaryRadius = 0.75;
    const minBoundary = -0.75 + worldBoundaryRadius;
    const maxBoundary = mapSize * BLOCK_SIZE - 0.75 - worldBoundaryRadius;

    if (posRef.current.x < minBoundary) posRef.current.x = minBoundary;
    if (posRef.current.x > maxBoundary) posRef.current.x = maxBoundary;
    if (posRef.current.z < minBoundary) posRef.current.z = minBoundary;
    if (posRef.current.z > maxBoundary) posRef.current.z = maxBoundary;

    let nextVelocityY = velocityY.current - 65 * dt;
    if (nextVelocityY < -50) nextVelocityY = -50;

    let nextY = posRef.current.y + nextVelocityY * dt;

    const groundAfterMove = getGroundYAt(
      posRef.current.x,
      posRef.current.z,
      posRef.current.y,
    );

    if (nextVelocityY <= 0 && nextY <= groundAfterMove + 0.05) {
      nextY = groundAfterMove;
      nextVelocityY = 0;

      // ИСПРАВЛЕНИЕ: Добавили прыжок с мобилки
      if (keys["Space"] || mobileControls.jump) {
        nextVelocityY = 15;
        nextY += 0.05;
      }
    } else if (
      nextVelocityY > 0 &&
      !canFitAt(posRef.current.x, nextY, posRef.current.z)
    ) {
      nextVelocityY = 0;
    }

    velocityY.current = nextVelocityY;
    posRef.current.y = nextY;

    if (posRef.current.y < -25) {
      window.location.reload();
    }

    const currentChunkX = Math.floor(
      posRef.current.x / (chunkSize * BLOCK_SIZE),
    );
    const currentChunkZ = Math.floor(
      posRef.current.z / (chunkSize * BLOCK_SIZE),
    );

    if (
      currentChunkX !== lastChunk.current.x ||
      currentChunkZ !== lastChunk.current.z
    ) {
      lastChunk.current = { x: currentChunkX, z: currentChunkZ };
      onChunkChange(currentChunkX, currentChunkZ);
    }
  };

  return { updatePhysics };
}
</file>

<file path="src/components/Player/Player.scss">
$block-size: 40px;
$player-height: 80px;

.player {
  width: $block-size;
  height: $player-height;
  position: absolute;
  left: calc(var(--x) * #{$block-size});
  top: calc(var(--y) * #{$block-size} - 20px);

  // ИСПРАВЛЕНИЕ: Добавили rotateZ перед rotateX, чтобы игрок поворачивался за мышкой!
  transform: translateZ(calc(var(--z) * #{$block-size} + 20px))
    rotateZ(calc(var(--yaw) * -1deg)) rotateX(-90deg);

  transform-style: preserve-3d;

  .face {
    position: absolute;
    width: $block-size;
    height: $player-height;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background-color: #e53935;

    // ИСПРАВЛЕНИЕ: Не рисуем заднюю (внутреннюю) сторону граней, чтобы не мешать камере
    backface-visibility: hidden;
  }

  .front {
    transform: rotateY(0deg) translateZ($block-size / 2);

    display: flex;
    justify-content: center;
    align-items: flex-start; // Прижимаем маркер к верхней части головы

    .face-marker {
      width: 10px;
      height: 10px;
      background-color: black;
      border-radius: 50%;
      margin-top: 15px; // Черный круг находится ровно в 15px от макушки
    }
  }
  .back {
    transform: rotateY(180deg) translateZ($block-size / 2);
  }
  .left {
    transform: rotateY(-90deg) translateZ($block-size / 2);
  }
  .right {
    transform: rotateY(90deg) translateZ($block-size / 2);
  }

  .top {
    width: $block-size;
    height: $block-size;
    top: 0;
    transform: rotateX(90deg) translateZ($block-size / 2);
    background-color: #ff5252;
  }
}
